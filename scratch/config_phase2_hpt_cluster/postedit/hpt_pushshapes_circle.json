{
  "_target_": "egomimic.pl_utils.pl_model.ModelWrapper",
  "optimizer": {
    "_partial_": true,
    "_target_": "torch.optim.AdamW",
    "lr": 0.0001,
    "weight_decay": 0.0001
  },
  "robomimic_model": {
    "6dof": false,
    "_target_": "egomimic.algo.hpt.HPT",
    "ac_keys": {
      "pushshapes_sim": "actions"
    },
    "camera_transforms": null,
    "diffusion": true,
    "domains": [
      "pushshapes_sim"
    ],
    "encoder_specs": {
      "front_img_1": {
        "_target_": "egomimic.models.hpt_nets.ResNet",
        "output_dim": 128
      }
    },
    "eval_image_augs": {
      "_target_": "torchvision.transforms.Compose",
      "transforms": [
        {
          "_target_": "torchvision.transforms.Normalize",
          "mean": [
            0.485,
            0.456,
            0.406
          ],
          "std": [
            0.229,
            0.224,
            0.225
          ]
        }
      ]
    },
    "head_specs": {
      "pushshapes_sim": {
        "_target_": "egomimic.models.fm_policy.FMPolicy",
        "action_horizon": 32,
        "infer_ac_dims": {
          "pushshapes_sim": 2
        },
        "model": {
          "_target_": "egomimic.models.denoising_nets.CrossTransformer",
          "act_dim": 2,
          "act_seq": 32,
          "cond_dim": 128,
          "dropout": 0.1,
          "hidden_dim": 64,
          "mlp_layers": 4,
          "mlp_ratio": 4,
          "n_heads": 4,
          "nblocks": 4
        },
        "num_inference_steps": 50,
        "pooling": null,
        "time_dist": "beta"
      }
    },
    "multitask": false,
    "pretrained": false,
    "pretrained_checkpoint": "",
    "reverse_kl_samples": 8,
    "shared_obs_keys": [
      "front_img_1"
    ],
    "shared_stem_specs": {
      "front_img_1": {
        "_target_": "egomimic.models.hpt_nets.MLPPolicyStem",
        "input_dim": 128,
        "output_dim": 128,
        "specs": {
          "cross_attn": {
            "crossattn_dim_head": 32,
            "crossattn_heads": 4,
            "crossattn_latent": 16,
            "crossattn_modality_dropout": 0.1,
            "modality_embed_dim": 128
          },
          "random_horizon_masking": false
        },
        "widths": [
          128
        ]
      }
    },
    "stem_specs": {
      "pushshapes_sim": {
        "state_agent_obj": {
          "_target_": "egomimic.models.hpt_nets.MLPPolicyStem",
          "input_dim": 5,
          "output_dim": 128,
          "specs": {
            "cross_attn": {
              "crossattn_dim_head": 32,
              "crossattn_heads": 4,
              "crossattn_latent": 16,
              "crossattn_modality_dropout": 0.1,
              "modality_embed_dim": 128
            },
            "random_horizon_masking": false
          },
          "widths": [
            128
          ]
        }
      }
    },
    "train_image_augs": {
      "_target_": "torchvision.transforms.Compose",
      "transforms": [
        {
          "_target_": "torchvision.transforms.ColorJitter",
          "brightness": 0.1,
          "contrast": 0.1,
          "hue": 0.05,
          "saturation": 0.1
        },
        {
          "_target_": "torchvision.transforms.Normalize",
          "mean": [
            0.485,
            0.456,
            0.406
          ],
          "std": [
            0.229,
            0.224,
            0.225
          ]
        }
      ]
    },
    "trunk": {
      "action_horizon": 32,
      "drop_path": 0.1,
      "embed_dim": 128,
      "no_trunk": false,
      "num_blocks": 6,
      "num_heads": 4,
      "observation_horizon": 1,
      "token_postprocessing": "action_token",
      "use_domain_embedding": true,
      "weight_init_style": "pytorch"
    }
  },
  "scheduler": {
    "_partial_": true,
    "_target_": "torch.optim.lr_scheduler.LinearLR",
    "end_factor": 1,
    "start_factor": 1
  }
}
