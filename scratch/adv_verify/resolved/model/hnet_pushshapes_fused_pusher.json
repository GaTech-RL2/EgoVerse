{
  "_target_": "egomimic.pl_utils.pl_model.ModelWrapper",
  "optimizer": {
    "_partial_": true,
    "_target_": "torch.optim.AdamW",
    "lr": 0.0001,
    "weight_decay": 0.0001
  },
  "robomimic_model": {
    "_target_": "egomimic.algo.hnet.HNetFused",
    "ac_keys": {
      "pushshapes_sim": "actions"
    },
    "action_dim": 2,
    "action_horizon": 400,
    "arch_layout": "T8",
    "cond_encoder": {
      "_target_": "egomimic.models.hnet_nets.cond_encoders.CondEncoderModule",
      "cond_proj_widths": [
        128,
        128
      ],
      "d_cond": 128,
      "img_encoders": {
        "front_img_1": {
          "_target_": "egomimic.models.hnet_nets.image_encoders.SimpleConv",
          "channels": [
            32,
            64,
            128,
            256
          ],
          "embed_dim": 128,
          "in_channels": 3,
          "kernel_size": 3,
          "norm_groups": 8,
          "stride": 2
        }
      },
      "obs_specs": {
        "state_agent_obj": {
          "embed_dim": 64,
          "input_dim": 2,
          "input_slice": [
            0,
            2
          ],
          "widths": [
            128
          ]
        }
      },
      "output_key": "fused_cond"
    },
    "d_cond": 128,
    "d_intermediate": 512,
    "d_model": 128,
    "domains": [
      "pushshapes_sim"
    ],
    "num_heads": 4
  },
  "scheduler": {
    "_partial_": true,
    "_target_": "torch.optim.lr_scheduler.LinearLR",
    "end_factor": 1,
    "start_factor": 1
  }
}
