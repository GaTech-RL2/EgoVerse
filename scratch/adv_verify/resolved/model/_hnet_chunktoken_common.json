{
  "_target_": "egomimic.pl_utils.pl_model.ModelWrapper",
  "optimizer": {
    "_partial_": true,
    "_target_": "torch.optim.AdamW",
    "weight_decay": 0.0001
  },
  "robomimic_model": {
    "_target_": "egomimic.algo.hnet_chunk.HNetChunkToken",
    "ac_keys": {
      "pushshapes_sim": "actions"
