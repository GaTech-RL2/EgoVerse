{
  "ckpt_path": null,
  "defaults": [
    {
      "model": "hpt_bc_flow_eva"
    },
    {
      "paths": "default"
    },
    {
      "trainer": "ddp"
    },
    {
      "debug": null
    },
    {
      "logger": "wandb"
    },
    {
      "data": "eva"
    },
    {
      "callbacks": "checkpoints"
    },
    {
      "evaluator": "eval_hpt"
    },
    {
      "override hydra/launcher": "submitit"
    },
    "_self_"
  ],
  "description": "test",
  "hydra": {
    "run": {
      "dir": "./logs/${name}/${description}_${now:%Y-%m-%d_%H-%M-%S}"
    },
    "sweep": {
      "dir": "./logs/${name}/${description}_${now:%Y-%m-%d_%H-%M-%S}"
    }
  },
  "launch_params": {
    "gpus_per_node": 1,
    "nodes": 1
  },
  "mode": "train",
  "name": "test",
  "norm_stats": {
    "norm_mode": "quantile",
    "num_workers": 4,
    "precomputed_norm_path": null,
    "sample_frac": 1.0,
    "save_cache_dir": "${hydra:runtime.output_dir}"
  },
  "reject_outliers": true,
  "seed": 42
}
