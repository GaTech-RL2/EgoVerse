      "hidden_dim": 400,
      "input_dim": 128,
      "num_layers": 2
    },
    "domains": [
      "pushshapes_sim"
    ],
    "gmm_head": {
      "_target_": "egomimic.models.bc_rnn_nets.GMMActionHead",
      "action_dim": 2,
