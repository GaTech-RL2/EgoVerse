{
  "_target_": "egomimic.pl_utils.pl_model.ModelWrapper",
  "optimizer": {
    "_partial_": true,
    "_target_": "torch.optim.Adam",
    "lr": 0.0001,
    "weight_decay": 0.0
  },
  "robomimic_model": {
    "_target_": "egomimic.algo.bc_rnn.BCRNN",
    "ac_keys": {
      "pushshapes_sim": "actions"
    },
    "action_dim": 2,
    "action_horizon": 1024,
    "actor_mlp_dims": [
      1024,
      1024
    ],
    "core_net": {
      "_target_": "egomimic.models.bc_rnn_nets.LSTMCore",
