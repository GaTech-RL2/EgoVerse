          "crop_height": 86,
          "crop_width": 86,
          "feature_dimension": 64,
          "image_size": 96,
          "in_channels": 3,
          "num_kp": 32,
          "pretrained": false
        }
      },
      "obs_specs": {
        "state_agent_obj": {
          "embed_dim": 64,
          "input_dim": 2,
          "input_slice": [
            0,
            2
          ],
          "widths": [
            128
          ]
        }
      }
    },
    "rnn_horizon": 10
  },
  "scheduler": {
    "_partial_": true,
    "_target_": "egomimic.utils.schedulers.constant_scheduler"
  }
}
