{
  "accelerator": "gpu",
  "check_val_every_n_epoch": 200,
  "defaults": [
    "default"
  ],
  "devices": "${eval:'${launch_params.gpus_per_node} * ${launch_params.nodes}'}",
  "num_nodes": "${launch_params.nodes}",
  "num_sanity_val_steps": 0,
  "strategy": "ddp_find_unused_parameters_true",
  "sync_batchnorm": true
}
