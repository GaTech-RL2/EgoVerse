      "d_ff": 3200,
      "dropout": 0.1,
      "h": 8,
      "hidden_dim": 512,
      "latent_dim": 32,
      "num_layers": 4
    },
    "train_image_augs": {
      "_target_": "torchvision.transforms.Compose",
      "transforms": [
        {
          "_target_": "torchvision.transforms.ColorJitter",
          "brightness": 0.1,
          "contrast": 0.1,
          "hue": 0.05,
          "saturation": 0.1
        },
        {
          "_target_": "torchvision.transforms.Normalize",
          "mean": [
            0.485,
            0.456,
            0.406
          ],
          "std": [
            0.229,
            0.224,
            0.225
          ]
        }
      ]
    },
    "transformer": {
      "_target_": "egomimic.models.act_nets.Transformer",
      "d": 512,
      "d_ff": 3200,
      "dropout": 0.1,
      "h": 8,
      "num_layers": 7
    }
  },
  "scheduler": {
    "_partial_": true,
    "_target_": "torch.optim.lr_scheduler.LinearLR",
    "end_factor": 1,
    "start_factor": 1
