{
  "_target_": "egomimic.pl_utils.pl_model.ModelWrapper",
  "optimizer": {
    "_partial_": true,
    "_target_": "torch.optim.AdamW",
    "lr": 5e-05,
    "weight_decay": 0.0001
  },
  "robomimic_model": {
    "_target_": "egomimic.algo.hnet.HNet",
    "ac_keys": {
      "pushshapes_sim": "actions"
    },
    "action_dim": 2,
    "action_horizon": 400,
    "cond_encoder": {
      "_target_": "egomimic.models.hnet_nets.cond_encoders.CondEncoderModule",
      "cond_proj_widths": [
        128,
        128
      ],
      "d_cond": 128,
      "img_encoders": {
        "front_img_1": {
          "_target_": "egomimic.models.hnet_nets.image_encoders.SimpleConv",
          "channels": [
            32,
            64,
            128,
            256
          ],
          "embed_dim": 128,
          "in_channels": 3,
          "kernel_size": 3,
          "norm_groups": 8,
          "stride": 2
        }
      },
      "obs_specs": {
        "state_agent_obj": {
          "embed_dim": 64,
          "input_dim": 5,
          "widths": [
            128
          ]
        }
      },
      "output_key": "fused_cond"
    },
    "d_cond": 128,
    "d_model": 128,
    "domains": [
      "pushshapes_sim"
    ],
    "hnet": {
      "_target_": "egomimic.models.hnet_nets.hnet.HNet",
      "stages": [
        {
          "_target_": "egomimic.models.hnet_nets.stages.EncoderDecoderStage",
          "causal": true,
          "cond_key": "fused_cond",
          "d_cond": 128,
          "decoder": {
            "arch_layout": "T4",
            "cond": true,
            "d_intermediate": 512,
            "d_model": 128,
            "num_heads": 4
          },
          "encoder": {
            "arch_layout": "T4",
            "cond": true,
            "d_intermediate": 512,
            "d_model": 128,
            "num_heads": 4
          },
          "input_hidden_dim": 128,
          "output_hidden_dim": 128
        },
        {
          "_target_": "egomimic.models.hnet_nets.stages.ChunkerStage",
          "cond_key": "fused_cond",
          "input_hidden_dim": 128,
          "output_hidden_dim": 192,
          "ratio_loss_weight": 0.03,
          "target_compression_ratio": 8.0
        },
        {
          "_target_": "egomimic.models.hnet_nets.stages.ComputeStage",
          "causal": true,
          "cond_key": "fused_cond",
          "d_cond": 128,
          "input_hidden_dim": 192,
          "main_network": {
            "arch_layout": "T4",
            "cond": false,
            "d_intermediate": 768,
            "d_model": 192,
            "num_heads": 4
          },
          "output_hidden_dim": 192
        }
      ]
    },
    "init_weights_range": 0.02,
    "lr_multipliers": [
      3.0,
      1.7,
      0.9
    ],
    "use_parameter_groups": true,
    "weight_decay": 0.01
  },
  "scheduler": {
    "_partial_": true,
    "_target_": "torch.optim.lr_scheduler.LinearLR",
    "end_factor": 1,
    "start_factor": 1
  }
}
