+
+
+def warmup_stable_decay_extension(
+    optimizer: torch.optim.Optimizer,
+    restart_step: int,
+    warmup: int,
+    stable: int,
+    decay: int,
+    previous_warmup: int,
+    previous_stable: int,
+    previous_decay: int,
+    warmup_start_factor: float = 1.0e-3,
+    min_factor: float = 0.0,
+) -> torch.optim.lr_scheduler.LambdaLR:
+    """Continue a completed WSD run with a second, continuous WSD phase.
+
+    ``restart_step`` is the checkpoint's global optimizer step. The earlier
+    phase is reconstructed exactly, so loading its LambdaLR state keeps the
+    checkpoint LR continuous. The extension warms from that LR to the peak,
+    holds it, then decays to ``min_factor`` at the new total step budget.
+    """
+    lengths = (restart_step, warmup, stable, decay, previous_warmup,
+               previous_stable, previous_decay)
+    if any(value < 0 for value in lengths):
+        raise ValueError("WSD phase lengths and restart_step must be >= 0")
+    if not 0.0 <= warmup_start_factor <= 1.0 or not 0.0 <= min_factor <= 1.0:
+        raise ValueError("WSD factors must be in [0, 1]")
+    old_decay_start = previous_warmup + previous_stable
+    old_end = old_decay_start + previous_decay
+    if restart_step > old_end:
+        raise ValueError("restart_step cannot exceed the previous WSD budget")
+
+    def old_factor(step: int) -> float:
+        if step < previous_warmup:
+            return warmup_start_factor + (1.0 - warmup_start_factor) * step / previous_warmup
+        if step < old_decay_start:
+            return 1.0
+        if step < old_end:
+            return 1.0 - (1.0 - min_factor) * (step - old_decay_start) / previous_decay
+        return min_factor
+
+    restart_factor = old_factor(restart_step)
+    decay_start = restart_step + warmup + stable
+    end_step = decay_start + decay
+
+    def factor(step: int) -> float:
+        if step < restart_step:
+            return old_factor(step)
+        if step < restart_step + warmup:
+            return restart_factor + (1.0 - restart_factor) * (step - restart_step) / warmup
+        if step < decay_start:
+            return 1.0
+        if step < end_step:
+            return 1.0 - (1.0 - min_factor) * (step - decay_start) / decay
+        return min_factor
+
+    return torch.optim.lr_scheduler.LambdaLR(optimizer, factor)
