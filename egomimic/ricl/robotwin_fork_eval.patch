+            except Exception:
+                pass
+            succ_seed -= 1
+            now_seed += 1
+            print(f"unstable scene, resampling seed: {e}")
+            continue
+        except Exception as e:
+            try:
+                TASK_ENV.close_env()
+            except Exception:
+                pass
+            succ_seed -= 1
