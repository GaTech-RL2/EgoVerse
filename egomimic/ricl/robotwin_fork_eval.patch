+        # physics-settling check raises UnStableError for some random object
+        # placements (intended to be resampled, common under domain randomization),
+        # and other init errors shouldn't crash the whole eval. Resample a fresh
+        # seed instead. succ_seed was already incremented above for the no-expert
+        # path, so undo it before retrying.
+        try:
+            TASK_ENV.setup_demo(now_ep_num=now_id, seed=now_seed, is_test=True, **args)
