diff --git a/envs/robot/planner.py b/envs/robot/planner.py
index 21ae432..6b9d6e4 100644
--- a/envs/robot/planner.py
+++ b/envs/robot/planner.py
@@ -271,9 +271,40 @@ try:
             return result_p, result_q
     
 except Exception as e:
-    print('[planner.py]: Something wrong happened when importing CuroboPlanner! Please check if Curobo is installed correctly. If the problem still exists, you can install Curobo from https://github.com/NVlabs/curobo manually.')
-    print('Exception traceback:')
-    traceback.print_exc()
+    # EgoVerse patch: curobo is intentionally NOT installed for policy eval (the
+    # policy drives the arms directly in joint space, so no arm motion planning is
+    # needed). Provide an in-process stub so envs/robot import cleanly and the robot
+    # can still build a "planner". Only gripper interpolation is exercised at eval.
+    print('[planner.py]: Curobo unavailable — using EgoVerse no-op CuroboPlanner stub '
+          '(policy eval needs no arm motion planning).')
+
+    class CuroboPlanner:
+        def __init__(self, robot_origion_pose, active_joints_name, all_joints, yml_path=None):
+            self.robot_origion_pose = robot_origion_pose
+            self.active_joints_name = active_joints_name
+            self.all_joints = all_joints
+            self.yml_path = yml_path
+
+        def plan_grippers(self, now_val, target_val):
+            # Identical to the real CuroboPlanner.plan_grippers (linear interpolation).
+            num_step = 200
+            dis_val = target_val - now_val
+            step = dis_val / num_step
+            res = {}
+            vals = np.linspace(now_val, target_val, num_step)
+            res["num_step"] = num_step
+            res["per_step"] = step
+            res["result"] = vals
+            return res
+
+        def update_point_cloud(self, *args, **kwargs):
+            return None
+
+        def __getattr__(self, name):
+            # Any unused arm-planning method (plan_path/plan_pose/plan_batch/...) is a no-op.
+            def _noop(*args, **kwargs):
+                return {"status": "Fail"}
+            return _noop
 
 
